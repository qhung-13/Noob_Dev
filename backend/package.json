    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/pg": "^8.20.0",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^10.0.0",
    "eslint": "^10.8.0",
    "pino-pretty": "^11.3.0",
    "prisma": "^7.8.0",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.23.1",
